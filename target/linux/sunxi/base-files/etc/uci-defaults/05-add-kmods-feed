#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later

# include/feeds.mk only emits the kmods feed line into
# /etc/apk/repositories.d/distfeeds.list when CONFIG_BUILDBOT is set, and
# that same option also skips installing this build's own local apk
# signing key (package/base-files/Makefile) - not a trade we want for a
# personal build. Add the entry by hand instead, scoped to the one board
# whose vermagic is deliberately pinned to the value published for the
# official 25.12.5 cortexa53 kmods feed (see target/linux/sunxi/Makefile).

. /lib/functions/system.sh

board=$(board_name)
[ "$board" = "radxa,cubie-a5e" ] || exit 0

line='%U/targets/%S/kmods/6.12.94-1-54c42a9af64da421c37305c250430d94/packages.adb'
file=/etc/apk/repositories.d/distfeeds.list

[ -f "$file" ] && ! grep -qxF "$line" "$file" && echo "$line" >> "$file"

exit 0
