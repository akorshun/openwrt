From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] net: mediatek: match bridge flows behind the YT922x CPU tag

The PPE receive hook runs before DSA removes the switch tag. L2 flow
lookup currently accepts only the MediaTek tag and skips YT922x frames,
even when tc flower has installed a bridge flow on the correct PPE.

Recognize the YT922x four-byte format and skip its outer VLAN-shaped
CPU tag before reading the optional bridge VLAN. The port control TCI
must not become part of the bridge flow key. Leave unsupported taggers
on the software path and validate header availability before access.

This supplies the receive-side lookup for cross-switch bridge offload;
a bridge flow manager such as bridger must still install and retire the
tc flower rules. The existing output path supplies the destination
switch tag.

Do not bind frames of a VLAN-filtering YT922x bridge: an untagged access
frame does not expose its bridge PVID to PPE.

Signed-off-by: JiaY-shi <shi05275@163.com>
[backport of target/linux/mediatek/patches-6.18/967-43 and the mtk_ppe.c
 part of 967-50 to 6.12; the tagger protocol is not an enumerator of
 enum dsa_tag_protocol here, so compare instead of switching on it]
Signed-off-by: Andrey Korshunov <razor1702@gmail.com>
---
--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -12,6 +12,7 @@
 #include <net/dst_metadata.h>
 #include <net/dsa.h>
 #include <net/ipv6.h>
+#include <linux/dsa/yt922x.h>
 
 #include "mtk_eth_soc.h"
 #include "mtk_ppe.h"
@@ -794,6 +795,20 @@ void __mtk_ppe_check_skb(struct mtk_ppe
 	int entry_len;
 	u8 *tag;
 
+#if IS_ENABLED(CONFIG_NET_DSA)
+	/* An untagged access frame does not expose its bridge PVID to PPE.
+	 * Do not bind it using a MAC-only key shared by distinct VLANs.
+	 */
+	if (netdev_uses_dsa(skb->dev) &&
+	    skb->dev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_YT922X_4B) {
+		struct dsa_port *dp;
+
+		dsa_switch_for_each_user_port(dp, skb->dev->dsa_ptr->ds)
+			if (dsa_port_is_vlan_filtering(dp))
+				return;
+	}
+#endif
+
 	spin_lock_bh(&ppe_lock);
 
 	if (FIELD_GET(MTK_FOE_IB1_STATE, hwe->ib1) == MTK_FOE_STATE_BIND)
@@ -826,12 +841,28 @@ void __mtk_ppe_check_skb(struct mtk_ppe
 	switch (skb->protocol) {
 #if IS_ENABLED(CONFIG_NET_DSA)
 	case htons(ETH_P_XDSA):
-		if (!netdev_uses_dsa(skb->dev) ||
-		    skb->dev->dsa_ptr->tag_ops->proto != DSA_TAG_PROTO_MTK)
+		if (!netdev_uses_dsa(skb->dev))
 			goto out;
 
-		if (!skb_metadata_dst(skb))
-			tag += 4;
+		if (skb->dev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_MTK) {
+			if (!skb_metadata_dst(skb))
+				tag += 4;
+		} else if (skb->dev->dsa_ptr->tag_ops->proto ==
+			   DSA_TAG_PROTO_YT922X_4B) {
+			/* The outer 802.1Q-shaped header is a CPU port tag,
+			 * not the bridge VID. Skip it before looking for an
+			 * optional customer VLAN header, just as the tagger
+			 * does later in the receive path.
+			 */
+			if (!pskb_may_pull(skb, 2 * VLAN_HLEN))
+				goto out;
+			tag = skb->data - 2;
+			if (get_unaligned_be16(tag) != ETH_P_8021Q)
+				goto out;
+			tag += VLAN_HLEN;
+		} else {
+			goto out;
+		}
 
 		if (get_unaligned_be16(tag) != ETH_P_8021Q)
 			break;
