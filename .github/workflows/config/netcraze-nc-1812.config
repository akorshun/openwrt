#
# Seed .config for the Netcraze NC-1812 build.
#
# Derived mechanically from the official 25.12.5 buildbot config:
#   https://downloads.openwrt.org/releases/25.12.5/targets/mediatek/filogic/config.buildinfo
#
# Keeping the kernel-relevant options identical to the buildbot is what
# makes kmod-* packages from the official 25.12.5 feed usable on this
# firmware. The vermagic is an md5 over the '=[ym]' lines of the kernel
# config, so any deviation there both changes the hash and - far worse -
# changes the kernel ABI the official modules were compiled against.
# CONFIG_KERNEL_KALLSYMS in particular sits inside an #ifdef in struct
# module, and every .ko carries its own struct module.
#
# Dropped from the buildbot config, none of which reaches the kernel
# config:
#   CONFIG_TARGET_DEVICE_* for the other ~170 filogic devices,
#   CONFIG_TARGET_ALL_PROFILES  - we build one image
#   CONFIG_ALL_NONSHARED        - every userspace package; on this target
#                                 only kmod-* packages carry KCONFIG, and
#                                 CONFIG_ALL_KMODS already covers those
#   CONFIG_SDK, CONFIG_SDK_LLVM_BPF, CONFIG_IB, CONFIG_MAKE_TOOLCHAIN,
#   CONFIG_JSON_CYCLONEDX_SBOM  - extra release artifacts, hours of build
#   CONFIG_BUILDBOT             - would drop this build's own apk signing
#                                 key from the image (package/base-files),
#                                 leaving the kmod-* packages we ship
#                                 alongside the firmware uninstallable
#   CONFIG_KERNEL_BUILD_USER, CONFIG_KERNEL_BUILD_DOMAIN
#                               - these only set KBUILD_BUILD_USER/HOST
#                                 (include/kernel.mk:113), i.e. the
#                                 "Linux version ... (builder@buildhost)"
#                                 banner. They are not kernel config
#                                 symbols and have no effect on module
#                                 compatibility. Deliberately left unset:
#                                 the banner is the only visible marker
#                                 that this image is not an official
#                                 build, and it should stay truthful.
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcraze_nc-1812=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_netcraze_nc-1812=""
CONFIG_ALL_KMODS=y
CONFIG_DEVEL=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AUTOREMOVE=y
CONFIG_COLLECT_KERNEL_DEBUG=y
CONFIG_IMAGEOPT=y
# CONFIG_KERNEL_KALLSYMS is not set
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_BUG_URL=""
CONFIG_VERSION_CODE=""
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_FIRMWARE_URL=""
CONFIG_VERSION_HOME_URL=""
CONFIG_VERSION_HWREV=""
CONFIG_VERSION_MANUFACTURER=""
CONFIG_VERSION_MANUFACTURER_URL=""
CONFIG_VERSION_NUMBER=""
CONFIG_VERSION_PRODUCT=""
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12.5"
CONFIG_VERSION_SUPPORT_URL=""
